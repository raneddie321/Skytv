{
  "name": "skytv-streaming-app",
  "private": true,
  "version": "1.0.0",
  "description": "Sky-inspired Smart TV streaming application (independent demo, not affiliated with Sky).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/index.mjs --packages=external",
    "start": "node dist-server/index.mjs",
    "preview": "npm run build && npm start",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "screenshots": "playwright test --project=screenshots && node scripts/contact-sheet.mjs",
    "demo-assets": "node scripts/demo-art/render.mjs && bash scripts/make-sample-video.sh",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "hls.js": "1.7.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "^0.25.0",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
