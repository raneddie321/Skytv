# ---------------------------------------------------------------------------
# Server-side only (never exposed to the browser bundle)
# ---------------------------------------------------------------------------
# TMDB API v3 key. Used only by the TMDB proxy (server/tmdbProxy.ts).
TMDB_API_KEY=
# Optional TMDB upstream override (useful for testing).
TMDB_API_BASE=https://api.themoviedb.org/3
# Port for the production server (npm start).
PORT=8080
# Serve the reference mock REST API (/api/v1) from the dev/production server.
ENABLE_MOCK_API=true

# ---------------------------------------------------------------------------
# Client configuration (exposed to the frontend at build time)
# ---------------------------------------------------------------------------
# mock   = profiles, watchlist, history, live TV, playback etc. use local mock services
# remote = every service talks to the REST API described in docs/api/openapi.yaml
DATA_MODE=mock
# tmdb     = catalog metadata from TMDB through the proxy (falls back to the offline
#            demo catalog, with a visible notice, if TMDB is unreachable)
# fixtures = always use the offline demo catalog (fictional titles, generated artwork)
CATALOG_SOURCE=tmdb
# Base URL of the REST API used when DATA_MODE=remote.
API_BASE_URL=/api/v1
# Path or URL of the TMDB proxy.
TMDB_PROXY_URL=/api/tmdb
